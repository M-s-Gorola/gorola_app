# ==============================================================================
# GoRola Monorepo — Environment Variables Template (.env.example)
# ==============================================================================
# Copy this file to `.env` in the project root for local development.
# Reference: See `DATABASE and SETUP/LOCAL_SETUP.md` for full instructions.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database & Cache (PostgreSQL 15 & Redis 7)
# ------------------------------------------------------------------------------
# Runtime DML connection (app_service role)
DATABASE_URL="postgresql://app_service:postgres_app_123@localhost:5432/gorola_dev"

# Automated test suite database connection
DATABASE_URL_TEST="postgresql://app_service:postgres_app_123@localhost:5432/gorola_test"

# Migration / DDL connection (db_owner role with CREATEDB)
DIRECT_URL="postgresql://db_owner:postgres_owner_123@localhost:5432/gorola_dev"
MIGRATION_DATABASE_URL="postgresql://db_owner:postgres_owner_123@localhost:5432/gorola_dev"
MIGRATION_DATABASE_URL_TEST="postgresql://db_owner:postgres_owner_123@localhost:5432/gorola_test"

# Redis Cache & BullMQ Queue connection
REDIS_URL="redis://localhost:6379"

# ------------------------------------------------------------------------------
# 2. Security & PII Encryption (DPDP Act Sec 8(5))
# ------------------------------------------------------------------------------
# AES-256-GCM 32-byte encryption key for personal data (phone numbers)
ENCRYPTION_KEY="gorola_default_pii_encryption_key_32bytes!!"

# HMAC-SHA256 32-byte secret key for blind indexing (phoneHash search lookups)
HMAC_SECRET="gorola_default_hmac_secret_key_32bytes!!"

# ------------------------------------------------------------------------------
# 3. DPDP Age Eligibility Gate (18+ Only — Phase 8.8)
# ------------------------------------------------------------------------------
# Duration in days a phone number remains locked out after under-18 failure/erasure
AGE_GATE_LOCKOUT_DAYS=90

# Cooldown duration in hours for the `gorola_ag` device cookie
AGE_GATE_DEVICE_COOLDOWN_HOURS=24

# ------------------------------------------------------------------------------
# 4. JWT Authentication (RS256 Access Tokens)
# ------------------------------------------------------------------------------
# Local dev: leave empty to use auto-generated ephemeral RSA keys.
# Production (Railway): REQUIRED 2048-bit RSA PEM strings (with BEGIN/END lines).
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# ------------------------------------------------------------------------------
# 5. Server & Application Runtime
# ------------------------------------------------------------------------------
PORT=3001
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173

# Comma-separated allowed CORS browser origins (leave empty for open reflection in dev)
CORS_ALLOWED_ORIGINS=

# ------------------------------------------------------------------------------
# 6. Third-Party Integrations (Optional in Dev)
# ------------------------------------------------------------------------------
# Telecommunications SMS Gateway (Exotel / Fast2SMS)
FAST2SMS_API_KEY=

# Razorpay Payment Gateway (Test/Live API keys)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ------------------------------------------------------------------------------
# 7. OpenTelemetry & Monitoring (Optional)
# ------------------------------------------------------------------------------
OTEL_ENABLED=false
OTEL_SERVICE_NAME=gorola-api
OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces

# ------------------------------------------------------------------------------
# 8. Testing & Development Overrides
# ------------------------------------------------------------------------------
# Temporary fixed OTP for manual login testing before live SMS gateway integration
# GOROLA_DUMMY_OTP=123456
# GOROLA_OTP=123456

# Deterministic OTP for CI automated test runner (NODE_ENV=test only)
# GOROLA_TEST_OTP=111222

