# ==============================================================================
# GoRola API Backend — Environment Variables Template (apps/api/.env.example)
# ==============================================================================
# Copy this file to `apps/api/.env` for Prisma CLI operations and standalone API runs.
# Reference: See `DATABASE and SETUP/LOCAL_SETUP.md` for full setup instructions.
# ==============================================================================

# Runtime DML connection (app_service role)
DATABASE_URL="postgresql://app_service:postgres_app_123@localhost:5432/gorola_dev"

# Automated test suite database connection
DATABASE_URL_TEST="postgresql://app_service:postgres_app_123@localhost:5432/gorola_test"

# Migration / DDL connection (db_owner role with CREATEDB)
DIRECT_URL="postgresql://db_owner:postgres_owner_123@localhost:5432/gorola_dev"
MIGRATION_DATABASE_URL="postgresql://db_owner:postgres_owner_123@localhost:5432/gorola_dev"
MIGRATION_DATABASE_URL_TEST="postgresql://db_owner:postgres_owner_123@localhost:5432/gorola_test"

# Redis Cache & BullMQ Queue connection
REDIS_URL="redis://localhost:6379"

# Security & PII Encryption (DPDP Act Sec 8(5))
ENCRYPTION_KEY="gorola_default_pii_encryption_key_32bytes!!"
HMAC_SECRET="gorola_default_hmac_secret_key_32bytes!!"

# DPDP Age Eligibility Gate (18+ Only — Phase 8.8)
AGE_GATE_LOCKOUT_DAYS=90
AGE_GATE_DEVICE_COOLDOWN_HOURS=24

# JWT RS256 Authentication (Leave empty for ephemeral keys in dev)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=

# Server & Runtime Configuration
PORT=3001
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=info
FRONTEND_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=

# Integrations (Optional in Dev)
FAST2SMS_API_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# OpenTelemetry Monitoring
OTEL_ENABLED=false
OTEL_SERVICE_NAME=gorola-api
OTEL_EXPORTER_ENDPOINT=http://localhost:4318/v1/traces