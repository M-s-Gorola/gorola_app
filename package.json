{
  "name": "gorola-app",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:e2e": "pnpm --filter @gorola/web test:e2e --reporter=list",
    "build": "pnpm -r build",
    "security:audit": "node scripts/security-audit.mjs",
    "ci:quality": "pnpm --filter @gorola/shared build && pnpm security:audit && pnpm db:test:prepare && pnpm lint --max-warnings 0 && pnpm typecheck && pnpm build && pnpm test && pnpm --filter @gorola/web test:e2e --reporter=list",
    "ci:prisma": "pnpm --filter @gorola/api exec prisma generate && pnpm --filter @gorola/api exec prisma migrate deploy",
    "db:test:prepare": "pnpm --filter @gorola/api prisma:bootstrap:test",
    "db:local:bootstrap": "pnpm --filter @gorola/api prisma:bootstrap:local",
    "db:local:reset": "pnpm --filter @gorola/api prisma:reset",
    "db:local:seed": "pnpm --filter @gorola/api prisma:seed",
    "db:local:verify-seed": "pnpm --filter @gorola/api prisma:verify:seed"
  },

  "devDependencies": {
    "@eslint/js": "^9.24.0",
    "@types/dotenv-safe": "^9.1.0",
    "@types/node": "^22.14.1",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "eslint": "^9.24.0",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-security": "^4.0.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "globals": "^16.0.0",
    "jiti": "^2.6.1",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}